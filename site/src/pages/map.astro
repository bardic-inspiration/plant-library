---
import Base from '../layouts/Base.astro';
import Library from '../islands/Library.tsx';
import { Card } from '../components/ui/PlantCard';
import { buildData } from '../../../lib/build-data';

// The map view: the Library with its results drawn. Without JavaScript the page is the list, with a note.
const { index } = buildData();
const records = [...index.records].sort((a, b) => String(a.sort.name).localeCompare(String(b.sort.name)));
---
<Base current="map" title="Map">
  <h1 class="page-title">Map</h1>
  <p class="intro">
    The Library on a map: projects where they are, and plants through the projects that use them.
    The filters and search are the list view's own.
  </p>
  <Library client:only="preact" view="map" />
  <section id="library-fallback" aria-labelledby="all-heading">
    <p class="fallback-note">The map needs JavaScript and WebGL. Every entry is listed below instead.</p>
    <h2 id="all-heading" class="results-count">Every entry ({records.length})</h2>
    {records.length === 0 ? (
      <p>The library has no entries yet.</p>
    ) : (
      <ul role="list" class="card-grid">
        {records.map((r) => <li><Card record={r} /></li>)}
      </ul>
    )}
  </section>
</Base>

<style>
  .page-title {
    margin-block-end: var(--space-xs);
  }

  .intro {
    margin-block-end: var(--space-lg);
  }

  #library-fallback {
    margin-block-start: var(--space-lg);
  }

  .fallback-note {
    margin-block-end: var(--space-md);
  }

  #library-fallback .results-count {
    font-size: var(--size-h3);
    margin-block-end: var(--space-md);
  }

  #library-fallback .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--card-min), var(--full)), 1fr));
    gap: var(--grid-gap);
  }
</style>
