{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "submission.schema.json",
  "title": "Submission",
  "description": "What a contribution form files (docs/submissions.md). The envelope and the metadata are strict; the content (a draft entry, a change's value, a note) is loose, since cleaning it up is the routine's job.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "submittedAt", "submitter", "kind", "target"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "submittedAt": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$" },
    "submitter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" },
        "email": { "type": "string", "pattern": "^[^\\s@]+@[^\\s@]+$", "maxLength": 200 }
      }
    },
    "kind": { "enum": ["add", "edit", "photo", "note"] },
    "target": {
      "description": "<type>/<id> for edit, photo, and note; the type alone for add.",
      "type": "string", "pattern": "^[a-z]+(/[a-z0-9]+(-[a-z0-9]+)*)?$"
    },
    "entry": {
      "description": "For add: a draft entry in the type's shape. It needn't validate.",
      "type": "object"
    },
    "basedOn": {
      "description": "sha256 (hex) of the entry as the form opened it: JSON.stringify(entry, null, 2) plus a newline, the bytes of the published data/<type>/<id>.json.",
      "$ref": "#/$defs/sha256"
    },
    "basis": {
      "description": "For add: what the draft entry's claims rest on, as a change's basis does. Other kinds state theirs on each change, file, or note.",
      "enum": ["observation", "source", "correction"]
    },
    "sourceUrl": { "description": "For add with basis source: where the claims come from.", "$ref": "#/$defs/url" },
    "citation": { "description": "For add with basis source, when there is no URL.", "type": "string", "minLength": 1, "maxLength": 1000 },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    },
    "fieldNotes": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldNote" }
    },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file" }
    },
    "comment": { "type": "string", "maxLength": 20000 },
    "replyTo": { "$ref": "#/$defs/id" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "maxLength": 100 },
        "libraryBuild": { "type": "string", "maxLength": 100 }
      }
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "kind": { "const": "add" } }, "required": ["kind"] },
      "then": { "type": "object", "required": ["entry"], "properties": { "target": { "type": "string", "pattern": "^[a-z]+$" } } },
      "else": {
        "type": "object",
        "properties": { "target": { "type": "string", "pattern": "/" } },
        "not": { "anyOf": [{ "type": "object", "required": ["basis"] }, { "type": "object", "required": ["sourceUrl"] }, { "type": "object", "required": ["citation"] }] }
      }
    },
    {
      "if": { "type": "object", "properties": { "basis": { "const": "source" } }, "required": ["basis"] },
      "then": { "type": "object", "anyOf": [{ "type": "object", "required": ["sourceUrl"] }, { "type": "object", "required": ["citation"] }] }
    },
    {
      "if": { "type": "object", "properties": { "kind": { "const": "edit" } }, "required": ["kind"] },
      "then": { "type": "object", "required": ["basedOn", "changes"], "properties": { "changes": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "type": "object", "properties": { "kind": { "const": "photo" } }, "required": ["kind"] },
      "then": { "type": "object", "required": ["files"], "properties": { "files": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "type": "object", "properties": { "kind": { "const": "note" } }, "required": ["kind"] },
      "then": { "type": "object", "required": ["fieldNotes"], "properties": { "fieldNotes": { "type": "array", "minItems": 1 } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\n]*$" },
    "url": { "type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 2000 },
    "change": {
      "description": "One changed path, with exactly one of value (set, or null to clear), add, or remove (items of a list), its basis, and a note saying why.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "basis", "note"],
      "properties": {
        "path": {
          "description": "A dotted path into the entry. type, id, meta, and fieldNotes are not edited this way.",
          "type": "string", "pattern": "^(name|summary|description|tags|data)(\\.[A-Za-z0-9-]+)*$"
        },
        "value": {},
        "add": { "type": "array", "minItems": 1 },
        "remove": { "type": "array", "minItems": 1 },
        "basis": { "enum": ["observation", "source", "correction"] },
        "note": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "sourceUrl": { "$ref": "#/$defs/url" },
        "citation": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "oneOf": [
        { "type": "object", "required": ["value"] },
        { "type": "object", "required": ["add"] },
        { "type": "object", "required": ["remove"] }
      ],
      "if": { "type": "object", "properties": { "basis": { "const": "source" } }, "required": ["basis"] },
      "then": { "type": "object", "anyOf": [{ "type": "object", "required": ["sourceUrl"] }, { "type": "object", "required": ["citation"] }] }
    },
    "fieldNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "note"],
      "properties": {
        "topic": { "x-vocab": "fieldNoteTopic" },
        "note": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "region": { "x-vocab": "state" },
        "project": { "type": "string", "maxLength": 200 },
        "trait": { "type": "string", "maxLength": 200 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "bytes", "role", "rights"],
      "properties": {
        "name": {
          "description": "The file's name in the submission's folder: no folders, not hidden, not submission.json or result.json.",
          "type": "string", "pattern": "^(?!submission\\.json$|result\\.json$)[^./\\\\][^/\\\\]{0,199}$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["image", "plant-list", "supporting"] },
        "rights": { "enum": ["own-work", "organization-owned", "third-party"] },
        "license": { "type": "string", "maxLength": 100 },
        "sourceUrl": { "$ref": "#/$defs/url" },
        "photographer": { "type": "string", "maxLength": 200 },
        "takenAt": { "type": "string", "maxLength": 40 },
        "place": { "type": "string", "maxLength": 200 },
        "shows": { "type": "string", "maxLength": 200 },
        "alt": { "type": "string", "maxLength": 1000 }
      },
      "if": { "type": "object", "properties": { "rights": { "const": "third-party" } }, "required": ["rights"] },
      "then": { "type": "object", "required": ["sourceUrl"] }
    }
  }
}
