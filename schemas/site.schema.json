{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site.schema.json",
  "title": "Site settings (config/site.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "base", "fixturesOnly", "store", "basemap"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "base": {
      "description": "The path the site is served under. Starts and ends with a slash.",
      "type": "string",
      "pattern": "^/([A-Za-z0-9._~-]+/)*$"
    },
    "fixturesOnly": {
      "description": "When true, every project and palette must be a fixture with the proprietary fields blank.",
      "type": "boolean"
    },
    "store": { "enum": ["browser", "folder"] },
    "basemap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "maxZoom"],
      "properties": {
        "file": { "type": "string" },
        "maxZoom": { "type": "integer", "minimum": 4, "maximum": 16 }
      }
    }
  }
}
