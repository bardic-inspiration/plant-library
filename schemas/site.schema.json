{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site.schema.json",
  "title": "Site settings (config/site.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "base", "fixturesOnly", "store", "submissions", "basemap"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "base": {
      "description": "The path the site is served under. Starts and ends with a slash.",
      "type": "string",
      "pattern": "^/([A-Za-z0-9._~-]+/)*$"
    },
    "fixturesOnly": {
      "description": "When true, every project and palette must be a fixture with the proprietary fields blank.",
      "type": "boolean"
    },
    "store": { "enum": ["browser", "folder"] },
    "submissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBytes", "image"],
      "properties": {
        "maxBytes": {
          "description": "The largest file a submission may carry, in bytes, per file role.",
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "plant-list", "supporting"],
          "properties": {
            "image": { "type": "integer", "minimum": 1 },
            "plant-list": { "type": "integer", "minimum": 1 },
            "supporting": { "type": "integer", "minimum": 1 }
          }
        },
        "image": {
          "description": "How `npm run inbox -- image` re-encodes a submitted photo for the library: the format it writes, the longest edge in pixels (smaller images aren't enlarged), and the encoder's quality (1-100; PNG ignores it).",
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "maxEdge", "quality"],
          "properties": {
            "format": { "enum": ["jpeg", "png", "webp"] },
            "maxEdge": { "type": "integer", "minimum": 64, "maximum": 10000 },
            "quality": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        }
      }
    },
    "basemap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "maxZoom"],
      "properties": {
        "file": { "type": "string" },
        "maxZoom": { "type": "integer", "minimum": 4, "maximum": 16 }
      }
    }
  }
}
