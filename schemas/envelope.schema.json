{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.schema.json",
  "title": "Entry envelope",
  "description": "The keys every entry has. `data` is validated separately by schemas/<type>.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "id", "summary", "data", "meta"],
  "properties": {
    "type": { "type": "string", "pattern": "^[a-z]+$" },
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "name": { "$ref": "common.schema.json#/$defs/shortText" },
    "summary": { "$ref": "common.schema.json#/$defs/sentence" },
    "data": { "type": "object" },
    "description": { "$ref": "common.schema.json#/$defs/markdown" },
    "tags": {
      "description": "Open organization. Every key becomes a filter.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "common.schema.json#/$defs/shortText" },
          { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/shortText" } }
        ]
      }
    },
    "fieldNotes": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/fieldNote" }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "revisedAt", "method"],
      "properties": {
        "createdAt": { "$ref": "common.schema.json#/$defs/date" },
        "revisedAt": { "$ref": "common.schema.json#/$defs/date" },
        "method": { "x-vocab": "metaMethod" },
        "submissions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$" } },
        "fixture": { "type": "boolean" }
      }
    }
  }
}
