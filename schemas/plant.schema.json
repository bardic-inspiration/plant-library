{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plant.schema.json",
  "title": "Plant data",
  "description": "The `data` of a plant entry: one taxon as it is specified on a plant schedule.",
  "type": "object",
  "additionalProperties": false,
  "required": ["genus", "commonNames", "family", "form", "sources"],
  "properties": {
    "genus": { "type": "string", "pattern": "^[A-Z][a-z]+$" },
    "species": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)?$" },
    "hybrid": { "type": "boolean" },
    "infraRank": { "x-vocab": "infraRank" },
    "infraEpithet": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)?$" },
    "cultivar": { "type": "string", "pattern": "^[A-Z0-9][^'\"‘’“”\\n]*$", "maxLength": 60 },
    "tradeName": { "type": "string", "pattern": "^[^'\"\\n]+$", "maxLength": 60 },
    "commonNames": {
      "description": "The first is the primary common name.",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/shortText" }
    },
    "synonyms": {
      "description": "Botanical names the plant has been sold or published under.",
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][a-z]+( [^\\n]+)?$", "maxLength": 120 }
    },
    "family": { "type": "string", "pattern": "^[A-Z][a-z]+aceae$" },
    "usdaSymbol": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}$" },

    "form": { "x-vocab": "form" },
    "lifeCycle": { "description": "How long the plant lives: annual, biennial, or perennial. Independent of form, the habit.", "x-vocab": "lifeCycle" },
    "foliage": { "x-vocab": "foliage" },
    "height": { "$ref": "common.schema.json#/$defs/range" },
    "spread": { "$ref": "common.schema.json#/$defs/range" },
    "growthRate": { "x-vocab": "growthRate" },
    "sun": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "x-vocab": "sun" } },
    "moisture": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "x-vocab": "moisture" } },
    "soil": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "texture": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "x-vocab": "soilTexture" } },
        "drainage": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "x-vocab": "soilDrainage" } },
        "ph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 3, "maximum": 10 },
            "max": { "type": "number", "minimum": 3, "maximum": 10 }
          }
        }
      }
    },
    "hardiness": { "$ref": "common.schema.json#/$defs/zoneRange" },
    "waterUse": { "x-vocab": "waterUse" },
    "tolerates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "x-vocab": "tolerates" } },
    "bloom": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "colors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "x-vocab": "bloomColor" } },
        "months": {
          "description": "Start and end month, 1 to 12. May wrap the year (11 to 2).",
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "common.schema.json#/$defs/month" },
            "end": { "$ref": "common.schema.json#/$defs/month" }
          }
        }
      }
    },
    "fallColor": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "x-vocab": "fallColor" } },
    "fruit": { "$ref": "common.schema.json#/$defs/shortText" },
    "wildlife": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "x-vocab": "wildlife" } },
    "uses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "x-vocab": "uses" } },
    "wetlandIndicator": {
      "description": "National Wetland Plant List rating per region.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "x-vocab": "wetlandRegion" },
      "additionalProperties": { "x-vocab": "wetlandRating" }
    },
    "nativeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "ecoregions"],
      "properties": {
        "states": { "type": "array", "uniqueItems": true, "items": { "x-vocab": "state" } },
        "ecoregions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]{1,3}$" } }
      }
    },

    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "alt", "shows", "credit", "license"],
        "properties": {
          "file": { "type": "string", "pattern": "^assets/images/plant/[a-z0-9-]+/[0-9]+\\.(jpg|png|webp)$" },
          "alt": { "$ref": "common.schema.json#/$defs/sentence" },
          "shows": { "x-vocab": "imageShows" },
          "credit": { "$ref": "common.schema.json#/$defs/shortText" },
          "license": { "x-vocab": "license" },
          "sourceUrl": { "$ref": "common.schema.json#/$defs/url" },
          "pinned": { "type": "boolean" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "accessed", "fields"],
        "properties": {
          "source": { "$ref": "common.schema.json#/$defs/slug" },
          "url": { "$ref": "common.schema.json#/$defs/url" },
          "accessed": { "$ref": "common.schema.json#/$defs/date" },
          "fields": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-zA-Z]+(\\.[a-zA-Z]+)?$" }
          },
          "contributor": {
            "description": "For staff-observation: who observed it.",
            "$ref": "common.schema.json#/$defs/person"
          },
          "note": { "$ref": "common.schema.json#/$defs/sentence" }
        }
      }
    },
    "furtherReading": {
      "description": "Links to pages that are not registered sources. Nothing is cited to them.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "$ref": "common.schema.json#/$defs/shortText" },
          "url": { "$ref": "common.schema.json#/$defs/url" }
        }
      }
    }
  }
}
