{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlays.schema.json",
  "title": "Map overlays (config/overlays.json)",
  "description": "Each overlay the map can draw, bottom to top. A new overlay is a data file and an entry here (P4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overlays"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "overlays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/overlay"
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^--map-[a-z0-9-]+$"
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "data",
        "kind",
        "legend",
        "selectable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "description": "`library` for the projects in the built index, `analysis` for a choropleth the map computes from the results, or a TopoJSON file's path from the repo root.",
          "type": "string",
          "pattern": "^(library|analysis|[A-Za-z0-9._/-]+\\.topojson)$"
        },
        "kind": {
          "enum": [
            "fill",
            "line",
            "point",
            "heat",
            "choropleth"
          ]
        },
        "style": {
          "description": "Token names (`--map-*`): `color` or a `palette` (neighbors differ) for fills, lines, and points; `outline` and `width` for lines, fill edges, and choropleth edges; `opacity`; `radius` for points; `ramp` for a heat or choropleth overlay, low to high.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "$ref": "#/$defs/token"
            },
            "palette": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/token"
              }
            },
            "outline": {
              "$ref": "#/$defs/token"
            },
            "width": {
              "$ref": "#/$defs/token"
            },
            "opacity": {
              "$ref": "#/$defs/token"
            },
            "radius": {
              "$ref": "#/$defs/token"
            },
            "ramp": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/token"
              }
            }
          }
        },
        "legend": {
          "description": "`single`: one swatch with the label; `features`: a swatch per feature, by name; `steps`: a choropleth's steps, from the figures it draws; `none`.",
          "enum": [
            "single",
            "features",
            "steps",
            "none"
          ]
        },
        "alwaysOn": {
          "type": "boolean"
        },
        "selectable": {
          "description": "Whether a feature can be picked as a region filter.",
          "type": "boolean"
        },
        "facets": {
          "description": "The facet a selection sets, by type: a facet id in config/types.json whose values are the features' ids.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "regions": {
          "description": "A choropleth's region overlays, by id, in order of preference: it draws by the first that is on, else the last.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "data": {
                "const": "library"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "alwaysOn": {
                "const": true
              }
            },
            "required": [
              "alwaysOn"
            ],
            "type": "object"
          },
          "else": {
            "required": [
              "style"
            ],
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "not": {
                  "const": "library"
                }
              },
              "kind": {
                "const": "fill"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "style": {
                "anyOf": [
                  {
                    "required": [
                      "color"
                    ],
                    "type": "object"
                  },
                  {
                    "required": [
                      "palette"
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "not": {
                  "const": "library"
                }
              },
              "kind": {
                "const": "line"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "style": {
                "required": [
                  "color",
                  "width"
                ],
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "not": {
                  "const": "library"
                }
              },
              "kind": {
                "const": "point"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "style": {
                "required": [
                  "color",
                  "radius"
                ],
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "heat"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "style": {
                "required": [
                  "ramp"
                ],
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "legend": {
                "const": "features"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "style": {
                "required": [
                  "palette"
                ],
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "selectable": {
                "const": true
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "facets"
            ],
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "choropleth"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "data": {
                "const": "analysis"
              },
              "legend": {
                "const": "steps"
              },
              "selectable": {
                "const": false
              },
              "style": {
                "required": [
                  "ramp",
                  "outline",
                  "width"
                ],
                "type": "object"
              }
            },
            "required": [
              "regions"
            ],
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "data": {
                "const": "analysis"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "kind": {
                "const": "choropleth"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "legend": {
                "const": "steps"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "kind": {
                "const": "choropleth"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "kind": {
                  "const": "choropleth"
                }
              },
              "required": [
                "kind"
              ]
            },
            "type": "object"
          },
          "then": {
            "not": {
              "required": [
                "regions"
              ]
            },
            "type": "object"
          }
        }
      ]
    }
  }
}
