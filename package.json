{
  "name": "plant-library",
  "version": "0.1.0",
  "private": true,
  "description": "A library of plant information for West Coast landscape architects, built as a static site from JSON files.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "build:index": "tsx scripts/build-index.ts",
    "build": "npm run build:index && astro build --root site",
    "dev": "npm run build:index && astro dev --root site",
    "preview": "tsx scripts/serve.ts",
    "check": "tsc --noEmit && stylelint \"site/src/**/*.{css,astro}\" && tsx scripts/links.ts",
    "links": "tsx scripts/links.ts",
    "lane": "tsx scripts/lane.ts",
    "pr-summary": "tsx scripts/pr-summary.ts",
    "coverage": "tsx scripts/coverage.ts",
    "test": "vitest run",
    "a11y": "tsx scripts/a11y.ts",
    "snapshots": "tsx scripts/snapshots.ts",
    "lint:css": "stylelint \"site/src/**/*.{css,astro}\"",
    "attribution": "tsx scripts/attribution.ts",
    "dev:fixtures": "PLANT_LIBRARY_DATA=tests/fixtures/library npm run dev",
    "build:fixtures": "PLANT_LIBRARY_DATA=tests/fixtures/library npm run build",
    "geo": "tsx scripts/geo.ts"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "@fontsource/montserrat": "^5.3.0",
    "astro": "^7.4.12",
    "marked": "^18.2.0",
    "minisearch": "^7.2.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/topojson-client": "^3.1.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lucide-static": "^1.74.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^18.0.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
